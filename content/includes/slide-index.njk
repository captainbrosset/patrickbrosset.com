{%- set slides = collections.all | deckSlides(deck) -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/assets/headshot-200.avif" rel="icon" sizes="16x16 32x32 128x128" type="image/avif">
  <title>Presenter board - {{ deck.title }}</title>
  <style>
    * { box-sizing: border-box; margin: 0; }

    body {
      font-family: system-ui, sans-serif;
      background: black;
      color: white;
    }

    /* The printout is shown when the URL ends with #printout. */
    #printout {
      display: none;
      padding: 1.5rem;
    }

    #printout:target {
      display: block;
    }

    body:has(#printout:target) #presenter {
      display: none;
    }

    #presenter {
      display: grid;
      grid-template-columns: 280px 1fr;
      height: 100vh;
    }

    #sidebar {
      overflow-y: auto;
      border-inline-end: 1px solid #333;
      padding: 1rem;
    }

    #sidebar h2 {
      font-size: 1rem;
      margin-block-end: .75rem;
      color: #888;
      text-transform: uppercase;
      letter-spacing: .05em;
    }

    #sidebar ol {
      padding-inline-start: 1.5rem;
      font-size: .85rem;
      line-height: 1.8;
    }

    #sidebar li {
      cursor: pointer;
      padding: .15rem .4rem;
      border-radius: 3px;
    }

    #sidebar li:hover {
      background: #333;
    }

    #sidebar li.current {
      background: #005fcc;
      color: white;
      font-weight: bold;
    }

    #main {
      display: flex;
      flex-direction: column;
      padding: 1.5rem;
      gap: 1rem;
      overflow: hidden;
    }

    #controls {
      display: flex;
      gap: 1rem;
      align-items: center;
      flex-shrink: 0;
    }

    #controls button,
    .view-link {
      display: inline-block;
      text-decoration: none;
      padding: .5rem 1.2rem;
      font-size: .95rem;
      cursor: pointer;
      border: none;
      border-radius: 4px;
      background: #005fcc;
      color: white;
    }

    #controls button:hover,
    .view-link:hover {
      background: #0070e0;
    }

    #current-info {
      font-size: 1.1rem;
      font-weight: bold;
      color: #aaa;
    }

    #slide-number {
      color: #666;
      font-size: .9rem;
    }

    #view-printout {
      margin-inline-start: auto;
    }

    #slide-preview {
      background: white;
      block-size: 20vh;
      inline-size: calc(16 * 20vh / 9);
    }

    #notes-area {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem;
      background: #222;
      border-radius: 8px;
      font-size: 1.3rem;
      line-height: 1.7;
      white-space: pre-line;
    }

    #notes-area p {
      margin-block-end: .75rem;
    }

    #notes-area em {
      color: #888;
    }

    #nav-buttons {
      display: flex;
      gap: .5rem;
      flex-shrink: 0;
    }

    #nav-buttons button {
      flex: 1;
      padding: .6rem;
      font-size: 1rem;
      cursor: pointer;
      border: none;
      border-radius: 4px;
      background: #333;
      color: #ccc;
    }

    #nav-buttons button:hover {
      background: #444;
    }

    #printout header {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      justify-content: space-between;
      margin-block-end: 1.5rem;
    }

    #printout ol {
      list-style: none;
      padding: 0;
      line-height: 1.5;
      display: grid;
      gap: 1rem;
    }

    #printout li {
      padding: 1rem;
      border-radius: 8px;
      background: #1a1a1a;
      border: 1px solid #333;
      break-inside: avoid;
    }

    .printout-title {
      font-size: 1rem;
      margin-block-end: .75rem;
      color: #ddd;
    }

    .printout-preview {
      display: block;
      width: min(100%, 960px);
      aspect-ratio: 16 / 9;
      border: 1px solid #555;
      background: white;
    }

    .printout-notes {
      margin-block-start: 1rem;
      color: #f0f0f0;
      white-space: pre-line;
    }
  </style>
</head>
<body>
  <div id="presenter">
    <div id="sidebar">
      <h2>Slides</h2>
      <ol id="list">
        {%- for slide in slides %}
        <li data-slug="{{ slide.slug }}">{{ slide.slug or "(title)" }}</li>
        {%- endfor %}
      </ol>
    </div>

    <div id="main">
      <div id="controls">
        <button id="launch">Launch presentation</button>
        <span id="current-info">No slide active</span>
        <span id="slide-number"></span>
        <a class="view-link" id="view-printout" href="#printout">View printout</a>
      </div>

      <iframe id="slide-preview"></iframe>

      <div id="notes-area">
        <p><em>Notes will appear here when a slide is active.</em></p>
        <p><em>Click "Launch presentation" to open the presentation window, then use Left/Right or PageUp/PageDown to navigate. Slides that reserve arrow keys for a demo require PageUp/PageDown in the presentation window.</em></p>
      </div>

      <div id="nav-buttons">
        <button id="nav-prev">&larr; Previous</button>
        <button id="nav-next">Next &rarr;</button>
      </div>
    </div>
  </div>

  <section id="printout">
    <header>
      <h1>{{ deck.title }}</h1>
      <a class="view-link" href="{{ page.url }}">Back to presenter view</a>
    </header>
    <ol>
      {%- for slide in slides %}
      <li data-slug="{{ slide.slug }}">
        <h2 class="printout-title">{{ loop.index }}. {{ slide.title or slide.slug }}</h2>
        <iframe class="printout-preview" src="{{ page.url }}{{ slide.slug }}" loading="lazy" title="Slide {{ loop.index }}"></iframe>
        <div class="printout-notes">
          {%- if slide.notes %}{{ slide.notes | safe }}{% else %}<p><em>No notes for this slide.</em></p>{% endif -%}
        </div>
      </li>
      {%- endfor %}
    </ol>
  </section>

  <script>
    const BASE = "{{ page.url }}";
    const DECK_TITLE = document.title.replace(/^Presenter board - /, '');

    const launchButton = document.getElementById('launch');
    const navPrevButton = document.getElementById('nav-prev');
    const navNextButton = document.getElementById('nav-next');
    const currentInfoEl = document.getElementById('current-info');
    const slideNumberEl = document.getElementById('slide-number');
    const notesAreaEl = document.getElementById('notes-area');
    const slidePreviewFrame = document.getElementById('slide-preview');
    const listItems = [...document.querySelectorAll('#list li')];
    const sequence = listItems.map(li => li.dataset.slug);

    const channel = new BroadcastChannel('slide-presenter');
    let currentSlideIndex = -1;

    function isPrintoutMode() {
      return location.hash === '#printout';
    }

    function updateDocumentTitle() {
      document.title = (isPrintoutMode() ? 'Printout' : 'Presenter board') + ' - ' + DECK_TITLE;
    }

    updateDocumentTitle();
    addEventListener('hashchange', updateDocumentTitle);

    listItems.forEach(li => {
      li.addEventListener('click', () => navigateTo(li.dataset.slug));
    });

    // Launch presentation in a new window.
    launchButton.addEventListener('click', () => {
      const slug = sequence.length > 0 ? sequence[0] : '';
      window.open(BASE + slug);
    });

    function navigateTo(slug) {
      channel.postMessage({ type: 'navigate', slug });
      updateCurrent(slug);
    }

    // Navigate from presenter board buttons.
    navPrevButton.addEventListener('click', function () {
      if (currentSlideIndex > 0) {
        navigateTo(sequence[currentSlideIndex - 1]);
      }
    });

    navNextButton.addEventListener('click', function () {
      if (currentSlideIndex >= 0 && currentSlideIndex < sequence.length - 1) {
        navigateTo(sequence[currentSlideIndex + 1]);
      }
    });

    // Also allow keyboard nav on the presenter board itself.
    document.addEventListener('keydown', function (e) {
      if (isPrintoutMode()) {
        return;
      }

      if (e.key === 'PageDown' || e.key === 'ArrowRight') {
        e.preventDefault();
        navNextButton.click();
      } else if (e.key === 'PageUp' || e.key === 'ArrowLeft') {
        e.preventDefault();
        navPrevButton.click();
      }
    });

    // Listen for slide changes from the presentation window.
    channel.onmessage = function (e) {
      if (e.data.type === 'slide-changed') {
        updateCurrent(e.data.slug);
      }
    };

    function updateCurrent(slug) {
      const slideIndex = sequence.indexOf(slug);
      currentSlideIndex = slideIndex;

      // Highlight current slide in the list.
      listItems.forEach(li => {
        const isCurrent = li.dataset.slug === slug;
        li.classList.toggle('current', isCurrent);
        if (isCurrent) {
          li.scrollIntoView({ block: 'nearest' });
        }
      });

      // Update header info.
      currentInfoEl.textContent = slug || '(title)';
      slideNumberEl.textContent =
        slideIndex >= 0 ? (slideIndex + 1) + ' / ' + sequence.length : '';

      // Load the preview.
      slidePreviewFrame.src = BASE + slug;

      // Notes are rendered at build time in the printout.
      const notes = document.querySelector('#printout li[data-slug="' + CSS.escape(slug) + '"] .printout-notes');
      notesAreaEl.innerHTML = notes ? notes.innerHTML : '<p><em>No notes for this slide.</em></p>';
    }
  </script>
</body>
</html>
